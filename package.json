{
  "name": "kokoro-reader",
  "version": "0.2.0",
  "description": "Listen to any webpage with natural AI speech generated locally by Kokoro-82M (ONNX) — a privacy-first Chrome extension.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && node scripts/validate-manifest.ts",
    "build:e2e": "KOKORO_E2E=1 vite build && KOKORO_E2E=1 vite build --config vite.content.config.ts && KOKORO_E2E=1 node scripts/validate-manifest.ts dist-e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "node scripts/package.ts",
    "icons": "node scripts/render-icons.ts",
    "pin-model": "node scripts/pin-model.ts",
    "pin-voice-packs": "node scripts/pin-voice-packs.ts",
    "build:espeak": "scripts/espeak/build.sh",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts",
    "benchmark": "BENCHMARK=1 playwright test tests/e2e/benchmark.spec.ts",
    "verify:speech": "QUALITY=1 playwright test tests/e2e/quality.spec.ts && python3 scripts/verify-speech.py"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "0.544.0",
    "motion": "12.23.24",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.16",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.1.27",
    "@types/node": "24.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "6.2.4",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SurajMazar/kokoro-reader.git"
  }
}
